# Copy this file to secrets.toml and fill in your values
# For HuggingFace Spaces: Add these as Secrets in your Space settings
# For Local: Create .streamlit/secrets.toml with your actual values

# Optional: MySQL connection for auto-saving predictions and loading from DB
# Format: mysql+pymysql://username:password@host:port/database_name
# Leave empty if you only want file-based uploads
MYSQL_URL = "mysql+pymysql://user:password@localhost:3306/student_db"
